{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "shots.schema.json",
  "title": "촬영 컷 목록",
  "description": "촬영 가이드 페이지(guide.html)와 AI 생성 스크립트가 함께 쓴다. 고객 사진 파일 이름은 컷 번호(01.jpg~17.jpg)와 맞춘다.",
  "type": "object",
  "required": ["version", "groups", "scenes", "shots"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "integer", "minimum": 1 },
    "groups": {
      "description": "컷 묶음. 가이드에서 이 순서로 보여준다",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "label"],
        "additionalProperties": false,
        "properties": {
          "id": { "enum": ["exterior", "interior", "detail"] },
          "label": { "description": "화면에 보이는 이름 (외관/실내/디테일)", "type": "string" },
          "note": { "description": "묶음 설명 한 줄", "type": "string" }
        }
      }
    },
    "scenes": {
      "description": "[내부용] AI로 만드는 장면 목록. usedFor.scene 이 이 id를 가리킨다. 고객에게는 안 보인다",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "description"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "description": { "type": "string" },
          "method": { "description": "생성 방식. image: 사진→장면 이미지, video: 장면 이미지로 영상, interpolate: 실제 사진 두 장 사이를 잇는 영상", "enum": ["image", "video", "interpolate"] }
        }
      }
    },
    "shots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "group", "required", "title", "howTo", "cameraPosition", "samplePhoto", "usedFor"],
        "additionalProperties": false,
        "properties": {
          "id": { "description": "컷 번호 (1부터). 고객 사진 파일 이름과 같다 (1 → 01.jpg)", "type": "integer", "minimum": 1, "maximum": 99 },
          "group": { "enum": ["exterior", "interior", "detail"] },
          "required": { "description": "필수 컷이면 true", "type": "boolean" },
          "title": { "description": "컷 이름 (예: 정면)", "type": "string", "minLength": 1 },
          "howTo": { "description": "찍는 법 한두 줄 (고객이 읽는 문장)", "type": "string", "minLength": 1 },
          "cameraPosition": { "$ref": "#/$defs/cameraPosition" },
          "samplePhoto": { "description": "예시 사진 경로 (public 기준). 파일이 없으면 가이드에 자리표시자가 보인다", "type": "string" },
          "usedFor": {
            "description": "[내부용] 이 사진이 어떤 장면 생성에 쓰이는지. 고객에게는 안 보인다",
            "type": "array",
            "items": {
              "type": "object",
              "required": ["scene", "role"],
              "additionalProperties": false,
              "properties": {
                "scene": { "description": "scenes[].id", "type": "string" },
                "role": {
                  "description": "reference: 장면 이미지의 참고 사진, start/end: 영상의 시작·끝 프레임, source: 색 바꾸기 등의 원본",
                  "enum": ["reference", "start", "end", "source"]
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "cameraPosition": {
      "description": "촬영 위치 도식용 정보. 차를 위에서 내려다본 그림 기준",
      "type": "object",
      "required": ["type"],
      "discriminator": { "propertyName": "type" },
      "oneOf": [
        {
          "description": "차 바깥을 빙 둘러서 찍는 위치",
          "type": "object",
          "required": ["type", "angleDeg", "distanceM", "height"],
          "additionalProperties": false,
          "properties": {
            "type": { "const": "orbit" },
            "angleDeg": {
              "description": "차 앞쪽을 0도로, 위에서 볼 때 시계 반대 방향으로 잰 각도. 90 = 운전석(왼쪽) 옆, 180 = 뒤, 270 = 조수석 옆",
              "type": "number", "minimum": 0, "exclusiveMaximum": 360
            },
            "distanceM": { "description": "차 가장자리에서 떨어진 거리(m, 대략)", "type": "number", "minimum": 0 },
            "height": { "description": "휴대폰 높이", "enum": ["headlight", "chest", "eye"] }
          }
        },
        {
          "description": "문을 열고 밖에서 안쪽을 찍는 위치",
          "type": "object",
          "required": ["type", "door"],
          "additionalProperties": false,
          "properties": {
            "type": { "const": "door" },
            "door": { "description": "어느 문 앞에 서는지 (left = 운전석 쪽)", "enum": ["front-left", "front-right", "rear-left", "rear-right"] },
            "aim": { "description": "어디를 향해 찍는지", "type": "string" }
          }
        },
        {
          "description": "차 안에 앉아서 찍는 위치",
          "type": "object",
          "required": ["type", "seat"],
          "additionalProperties": false,
          "properties": {
            "type": { "const": "inside" },
            "seat": { "enum": ["front-left", "front-right", "rear-left", "rear-center", "rear-right"] },
            "aim": { "type": "string" }
          }
        },
        {
          "description": "부품 가까이에서 찍는 클로즈업 (도식에는 표시하지 않아도 됨)",
          "type": "object",
          "required": ["type", "target"],
          "additionalProperties": false,
          "properties": {
            "type": { "const": "closeup" },
            "target": { "description": "찍는 부분", "enum": ["wheel", "headlight", "taillight", "emblem", "custom"] },
            "distanceM": { "type": "number", "minimum": 0 }
          }
        }
      ]
    }
  }
}
