{
  "$schema": "./site.schema.json",
  "profile": "owner",
  "meta": {
    "lang": "ko",
    "title": "JUN'S GARAGE — 내 차를 소개합니다",
    "description": "스크롤을 내리면 차가 움직이는 나만의 차량 소개 페이지.",
    "ogImage": "/images/og.webp"
  },
  "brand": {
    "name": "준의 차고",
    "logoText": "JUN'S GARAGE",
    "accentColor": "#D7FF3A",
    "backgroundColor": "#0A0A0B",
    "textColor": "#F2F2F0",
    "fonts": {
      "headline": {
        "family": "Anton",
        "weight": 400,
        "cssUrl": "https://fonts.googleapis.com/css2?family=Anton&display=swap"
      },
      "body": {
        "family": "Pretendard Variable",
        "cssUrl": "https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css"
      }
    }
  },
  "car": {
    "maker": "Hyundai",
    "model": "Avante N",
    "year": 2023,
    "color": "Performance Blue"
  },
  "contact": {
    "kakaoOpenChat": "https://open.kakao.com/o/sDEMO0000",
    "phone": "010-0000-0000",
    "instagram": "juns.garage"
  },
  "nav": {
    "ctaLabel": "문의하기"
  },
  "frames": {
    "basePath": "/frames",
    "mobileMaxWidth": 768,
    "digits": 4
  },
  "sections": [
    {
      "id": "hero",
      "type": "scrub",
      "scrollLength": 300,
      "frames": { "folder": "hero", "count": 0, "ext": "webp" },
      "copy": {
        "eyebrow": "2023 AVANTE N",
        "headline": "PULL\nUP.",
        "accentWord": "UP.",
        "subcopy": "매일 타는 내 차, 오늘은 주인공으로.",
        "position": "bottom-left"
      },
      "copyRange": [0.05, 0.6]
    },
    {
      "id": "detail",
      "type": "scrub",
      "scrollLength": 250,
      "frames": { "folder": "detail", "count": 0, "ext": "webp" },
      "copy": {
        "eyebrow": "01 — DETAIL",
        "headline": "CLOSE ENOUGH\nTO TOUCH.",
        "accentWord": "TOUCH.",
        "subcopy": "휠, 캘리퍼, 헤드램프. 매일 지나치던 디테일을 가장 가까이에서.",
        "position": "right"
      },
      "copyRange": [0.2, 0.8]
    },
    {
      "id": "night",
      "type": "scrub",
      "scrollLength": 300,
      "frames": { "folder": "night", "count": 0, "ext": "webp" },
      "copy": {
        "eyebrow": "02 — NIGHT RUN",
        "headline": "AFTER\nDARK.",
        "accentWord": "DARK.",
        "subcopy": "불이 켜지는 순간, 낮과는 다른 차가 됩니다.",
        "position": "left"
      },
      "copyRange": [0.25, 0.85]
    },
    {
      "id": "finish",
      "type": "picker",
      "copy": {
        "eyebrow": "03 — COLOR",
        "headline": "PICK YOUR\nFINISH.",
        "accentWord": "FINISH.",
        "subcopy": "같은 차, 다른 분위기. 색을 골라보세요.",
        "position": "left"
      },
      "defaultOption": "original",
      "options": [
        {
          "id": "original",
          "label": "퍼포먼스 블루",
          "swatch": "#1F4FD8",
          "image": { "desktop": "/images/finish/original-desktop.webp", "mobile": "/images/finish/original-mobile.webp" }
        },
        {
          "id": "matte-black",
          "label": "매트 블랙",
          "swatch": "#17181A",
          "image": { "desktop": "/images/finish/matte-black-desktop.webp", "mobile": "/images/finish/matte-black-mobile.webp" }
        },
        {
          "id": "nardo-grey",
          "label": "나르도 그레이",
          "swatch": "#8A8D8F",
          "image": { "desktop": "/images/finish/nardo-grey-desktop.webp", "mobile": "/images/finish/nardo-grey-mobile.webp" }
        },
        {
          "id": "chalk-white",
          "label": "초크 화이트",
          "swatch": "#E6E3DC",
          "image": { "desktop": "/images/finish/chalk-white-desktop.webp", "mobile": "/images/finish/chalk-white-mobile.webp" }
        }
      ]
    },
    {
      "id": "contact",
      "type": "cta",
      "copy": {
        "eyebrow": "CONTACT",
        "headline": "LET'S\nTALK.",
        "accentWord": "TALK.",
        "subcopy": "차 이야기, 동호회 모임, 무엇이든 편하게 연락 주세요.",
        "position": "center"
      },
      "kakaoLabel": "카카오톡으로 문의하기"
    }
  ]
}
